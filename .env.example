# ---------------------------------------------------------------------------
# pheasant-swarm-lab environment
#
# Copy to .env (which is git-ignored) and fill in. See docs/setup.md.
# For live commands use: uv run --env-file .env pheasant-lab ...
# The uv option loads API keys and tokens into the process environment used
# by the adapters; the lab's own .env reader resolves configuration fields.
# Known secrets are redacted in traces; ordinary settings remain inspectable.
# ---------------------------------------------------------------------------

# --- Model provider --------------------------------------------------------
# MODEL_PROVIDER selects the adapter in src/pheasant_lab/models/.
#   replay  - deterministic, offline, no network, no cost (the default)
#   openai  - OpenAI Responses API
#   anthropic - Anthropic Messages API
MODEL_PROVIDER=replay

# For a live run, replace ALL SIX replay IDs with real model IDs from the
# selected provider and add their actual prices to your local pricing file.
ORCHESTRATOR_MODEL=replay:orchestrator
RESEARCHER_MODEL=replay:researcher
SPECIALIST_MODEL=replay:specialist
TEST_AGENT_MODEL=replay:test-agent
CONTROL_MODEL=replay:control
BENCHMARK_MODEL=replay:benchmark

# Use null unless the chosen model and adapter support the requested effort.
ORCHESTRATOR_REASONING_EFFORT=medium
RESEARCHER_REASONING_EFFORT=medium
SPECIALIST_REASONING_EFFORT=high
TEST_AGENT_REASONING_EFFORT=high

# Secrets. Never committed, never written to a trace.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Versioned local pricing file. A model with no price fails preflight rather
# than being silently treated as free.
MODEL_PRICING_FILE=configs/pricing.example.yaml

# --- Pheasant MCP ----------------------------------------------------------
PHEASANT_MCP_TRANSPORT=streamable_http
PHEASANT_MCP_URL=http://127.0.0.1:8765/mcp
# Only read when PHEASANT_MCP_TRANSPORT=stdio; must be set explicitly.
PHEASANT_MCP_COMMAND=
PHEASANT_MCP_TOKEN=

# Match the EXISTING knowledge-base name shown in Pheasant. This variable
# does not create a knowledge base. Use a dedicated base and a new source:
# the lab submits source documents and can later seal snapshots there.
PHEASANT_KNOWLEDGE_BASE=pheasant-lab
PHEASANT_SOURCE_NAME=swarm-lab-literature
PHEASANT_DIAGNOSTIC_KNOWLEDGE_BASE=

# Tool names are configured rather than assumed: the server's surface may
# evolve, and doctor fails before a paid run when a configured name is absent
# from tools/list. These defaults match pheasant >= 0.12.
PHEASANT_TOOL_HEALTH=list_knowledge_bases
PHEASANT_TOOL_INGEST=submit_documents
PHEASANT_TOOL_INGEST_STATUS=get_ingest_status
PHEASANT_TOOL_INGEST_ACK=acknowledge_ingest
PHEASANT_TOOL_INGEST_RECONCILE=reconcile_ingest
PHEASANT_TOOL_SYNC=sync_source
PHEASANT_TOOL_SEARCH=search_context
PHEASANT_TOOL_FETCH=get_file_summary
PHEASANT_TOOL_MEMORY_WRITE=memory_write
PHEASANT_TOOL_SNAPSHOT=seal_snapshot
PHEASANT_TOOL_SNAPSHOT_GET=get_snapshot
PHEASANT_TOOL_DESCRIBE_RETRIEVAL=describe_retrieval
PHEASANT_TOOL_RECORD_EVIDENCE=record_evidence

# --- Literature providers --------------------------------------------------
# Contact address; OpenAlex and Crossref give a faster, more reliable pool to
# requests that identify themselves.
LITERATURE_CONTACT_EMAIL=
CROSSREF_MAILTO=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
