# pheasant-swarm-lab in Docker - copy to .env next to docker-compose.yml.
#
#   cp .env.docker.example .env
#
# Two values are required. One `openssl rand -hex 32` each, and different:
#
#   PHEASANT_API_TOKEN          the region's API key. The bundled `pheasant`
#                               service requires it (security.api_auth) and the
#                               lab sends it on every MCP call. For the lab
#                               fleet (docker-compose.fleet.yml), use the
#                               fleet's own value.
#   PHEASANT_LAB_CONSOLE_TOKEN  the console's key: the browser asks for it once
#                               per tab, MCP clients send it as a bearer token.
PHEASANT_API_TOKEN=
PHEASANT_LAB_CONSOLE_TOKEN=

# Optional. The first run uses the offline replay models and fixture
# literature and needs none of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
LITERATURE_CONTACT_EMAIL=
CROSSREF_MAILTO=
NCBI_API_KEY=

# Ports, published on loopback by default.
# PHEASANT_LAB_BIND=127.0.0.1
# PHEASANT_LAB_PORT=8770
# PHEASANT_BIND=127.0.0.1
# PHEASANT_PORT=8765

# Images. The region is pinned to the release this lab targets.
# PHEASANT_IMAGE=ghcr.io/esatt10/pheasant:0.14.0
# PHEASANT_LAB_IMAGE=pheasant-swarm-lab:local
