    "seal_snapshot": {
      "description": "Seal the current state as a run's reference snapshot.\n\nIdempotent over an unchanged region: the id is a digest of the state.\nPin a search to the returned `snapshot_id` and this region will answer\nfrom that state or refuse \u2014 it does not hold older corpus versions, so\nthe guarantee is that two runs naming one snapshot cannot silently have\nseen different corpora.\n",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "label": {
            "anyOf": [
