    "get_graph_neighbors": {
      "description": "Return graph neighbors around a node, breadth-first along outgoing edges.\n\nnode_id is any graph node id: a search hit's node_id or chunk_id, or a\nneighbour returned by search_context's expand. Structural (contains)\nedges are walked first. edge_types keeps only those edges;\nexclude_edge_types and exclude_node_types prune the walk itself, so a\nhub's indexes fan-out does not spend the budget. max_nodes bounds the\nwalk (unbounded by default; set it when starting from a directory or\nsource node). Each neighbour carries its depth, the edge types it was\nreached by, its path from node_id, and its attributes.\n",
      "inputSchema": {
        "properties": {
          "depth": {
            "default": 2,
            "title": "Depth",
            "type": "integer"
          },
          "edge_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Edge Types"
          },
          "exclude_edge_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Edge Types"
          },
          "exclude_node_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Node Types"
          },
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "max_nodes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Nodes"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          }
        },
        "required": [
          "knowledge_base",
          "node_id"
        ],
        "title": "get_graph_neighborsArguments",
        "type": "object"
      },
      "name": "get_graph_neighbors"
    },
    "get_graph_slice": {
      "description": "Return the connected sub-graph around a node: nodes plus every link among them.\n\nWhere get_graph_neighbors returns a list of nodes reached, this returns\nthe induced sub-graph (nodes, links between any two of them, and each\nnode's hop distance under depths), which is what you want to reason\nabout how a set of results relate to each other. truncated is true\nwhen the slice filled limit before running out of graph.\n",
      "inputSchema": {
        "properties": {
          "depth": {
            "default": 1,
            "title": "Depth",
            "type": "integer"
          },
          "edge_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Edge Types"
          },
          "exclude_edge_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Edge Types"
          },
          "exclude_node_types": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Exclude Node Types"
          },
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "limit": {
            "default": 100,
            "title": "Limit",
            "type": "integer"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          }
        },
        "required": [
          "knowledge_base",
          "node_id"
        ],
        "title": "get_graph_sliceArguments",
        "type": "object"
      },
      "name": "get_graph_slice"
    },
    "get_index_queue": {
      "description": "Outstanding index tasks and whether an indexer has claimed each one.\n\nOn a fleet, ``sync_source`` answers ``status: queued``: the sync was\npublished, not run. Each task here is ``awaiting_claim`` (no indexer\nhas taken it yet; watch ``waiting_seconds``), ``retry_scheduled``,\n``claimed``, ``claim_lapsed`` (its indexer stopped heartbeating) or\n``dead``. ``listing: \"unavailable\"`` means the backend can count its\nbacklog but not list it, so an empty ``tasks`` there is not \"nothing\nwaiting\". With the queue off, syncs run where they are asked and this\nreports ``enabled: false``.\n",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "title": "Limit",
            "type": "integer"
