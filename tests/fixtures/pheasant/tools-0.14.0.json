{
  "note": "tools/list entries for the tools the lab's capability map names, captured from a running pheasant. Regenerate against a new release rather than editing by hand (scripts/capture_pheasant_fixtures.py).",
  "server": {
    "name": "pheasant",
    "protocol_version": "2025-11-25",
    "version": "0.14.0"
  },
  "tools": {
    "acknowledge_ingest": {
      "description": "Cross the index barrier for receipts whose artifacts now exist.",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "submission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Submission Id"
          }
        },
        "required": [
          "knowledge_base"
        ],
        "title": "acknowledge_ingestArguments",
        "type": "object"
      },
      "name": "acknowledge_ingest"
    },
    "describe_retrieval": {
      "description": "Report how this knowledge base retrieves, and what you can override.\n\nReturns the standing configuration (default mode, result count,\nretrieval rounds and depth), which search modes actually work here\n(semantic search is only offered when a vector index exists), the\nsources present, and the criteria each retrieval tool accepts per\ncall. Call this before guessing at parameters for an unfamiliar\nregion.\n",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          }
        },
        "required": [
          "knowledge_base"
        ],
        "title": "describe_retrievalArguments",
        "type": "object"
      },
      "name": "describe_retrieval"
    },
    "describe_source": {
      "description": "Describe one source in detail, without searching it.\n\nReturns its type, location, status and last-indexed time; its document\ncount and size; its documents by file type and by top-level directory;\nthe five most recently indexed; and link counts per other source and\nedge type, outgoing (its documents link to) and incoming (linked from).\nLinks are graph edges between two indexed documents: resolved imports,\nreferences, embeds and the like. With security.acl_enforced on, only\ndocuments the principal may read are counted.\n",
      "inputSchema": {
        "properties": {
          "knowledge_base": {
            "title": "Knowledge Base",
            "type": "string"
          },
          "principal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Principal"
          },
          "principal_groups": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Principal Groups"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          }
        },
        "required": [
          "knowledge_base",
          "source_name"
        ],
        "title": "describe_sourceArguments",
        "type": "object"
      },
      "name": "describe_source"
    },
    "get_file_summary": {
      "description": "Return summary and provenance for one indexed file.",
