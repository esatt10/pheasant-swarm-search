    "submit_documents": {
      "description": "Persist documents with an idempotency key and one receipt per item.\n\nEach entry is ``{\"relative_path\", \"text\", \"idempotency_key\"?,\n\"metadata\"?}``. Re-submitting under a key this region has already seen\nfolds onto the receipt it wrote rather than making a second copy.\n\nSet content_encoding=\"base64\" to submit original PDF or other binary file bytes\nin each entry's text field. The default \"utf-8\" retains text submissions.\nHTTP MCP requests default to a 64 MiB whole-body limit, configurable with\nserver.mcp.max_request_body_size_mb. Account for base64 and JSON overhead;\nclients and proxies may impose smaller limits. Multipart /sources/upload\ndoes not preserve this tool's receipts or idempotency keys.\n\nAcceptance is not searchability: sync the source, then call\n`acknowledge_ingest`.\n",
      "inputSchema": {
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Agent Id"
          },
          "content_encoding": {
            "default": "utf-8",
            "title": "Content Encoding",
            "type": "string"
          },
          "documents": {
            "items": {
