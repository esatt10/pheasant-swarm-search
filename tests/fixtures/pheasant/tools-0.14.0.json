            "title": "Subject"
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Supersedes"
          },
          "sync": {
            "default": true,
            "title": "Sync",
            "type": "boolean"
          },
          "tags": {
